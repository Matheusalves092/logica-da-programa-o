programa

{

  funcao inicio()

  {

    inteiro v[8]

    inteiro i

 

    // Ler e guardar os 8 números

    para (i = 0; i < 8; i++)

    {

      leia(v[i])

    }

 

    // Mostrar cada número multiplicado por 2

    para (i = 0; i < 8; i++)

    {

      escreva(v[i] * 2, "\n")

    }

  }

}
